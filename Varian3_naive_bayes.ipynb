        "mask_diskrit = [f in categorical_features for f in semua_fitur]\n",
        "mi_scores = mutual_info_classif(X_mi, y_train, discrete_features=mask_diskrit, random_state=42)\n",
        "\n",
        "mi_df = (\n",
        "    pd.DataFrame({\"Fitur\": semua_fitur, \"Mutual Information\": mi_scores})\n",
        "    .sort_values(\"Mutual Information\", ascending=False)\n",
        "    .reset_index(drop=True)\n",
        ")\n",
        "mi_df.index += 1\n",
