      "source": [
        "## 17. Membuat Aplikasi Web (Streamlit)\n",
        "Cell berikut menulis `app.py` dan `requirements.txt`. Form input dibuat **otomatis** dari isi file model, jadi kalau skenario terbaik berubah, web tetap jalan tanpa edit kode."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 17,
      "id": "685d6fc7",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "685d6fc7",
        "outputId": "3b349fb8-8ab7-4699-a245-4f52be7c7890"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Writing app.py\n"
          ]
        }
      ],
      "source": [
        "%%writefile app.py\n",
        "import joblib\n",
        "import pandas as pd\n",
        "import streamlit as st\n",
        "\n",
        "st.set_page_config(page_title=\"Prediksi Penyakit Jantung\", page_icon=\"❤️\")\n",
        "\n",
        "\n",
        "@st.cache_resource\n",
        "def muat_model():\n",
        "    return joblib.load(\"model_naive_bayes_jantung.joblib\")\n",
        "\n",
        "\n",
        "bundle = muat_model()\n",
        "model = bundle[\"model\"]\n",
        "\n",
        "st.title(\"❤️ Prediksi Penyakit Jantung\")\n",
        "st.caption(\n",
        "    f\"Model: Gaussian Naive Bayes | Skenario fitur: {bundle['nama_skenario']} | \"\n",
        "    f\"Accuracy uji: {bundle['metrik']['accuracy']:.2%}\"\n",
        ")\n",
        "\n",
        "with st.form(\"form_prediksi\"):\n",
        "    data = {}\n",
        "    kolom = st.columns(2)\n",
        "    urutan = bundle[\"fitur\"]\n",
        "\n",
        "    for i, fitur in enumerate(urutan):\n",
        "        with kolom[i % 2]:\n",
        "            if fitur in bundle[\"numerical_features\"]:\n",
        "                r = bundle[\"rentang_numerik\"][fitur]\n",
        "                if r[\"min\"] == 0 and r[\"max\"] == 1 and r[\"integer\"]:\n",
        "                    data[fitur] = st.selectbox(fitur, [0, 1])\n",
        "                elif r[\"integer\"]:\n",
        "                    data[fitur] = st.number_input(\n",
        "                        fitur, min_value=int(r[\"min\"]), max_value=int(r[\"max\"]) * 2,\n",
        "                        value=int(r[\"median\"]), step=1,\n",
        "                    )\n",
        "                else:\n",
        "                    data[fitur] = st.number_input(\n",
        "                        fitur, min_value=float(r[\"min\"]), max_value=float(r[\"max\"]) * 2,\n",
        "                        value=float(r[\"median\"]), step=0.1,\n",
        "                    )\n",
        "            else:\n",
        "                data[fitur] = st.selectbox(fitur, bundle[\"opsi_kategori\"][fitur])\n",
        "\n",
        "    kirim = st.form_submit_button(\"Prediksi\")\n",
        "\n",
        "if kirim:\n",
        "    df_input = pd.DataFrame([data])\n",
        "    proba = model.predict_proba(df_input)[0][1]\n",
        "    pred = int(model.predict(df_input)[0])\n",
        "\n",
        "    if pred == 1:\n",
        "        st.error(f\"Hasil: **{bundle['label'][1]}** (risiko penyakit jantung terdeteksi)\")\n",
        "    else:\n",
        "        st.success(f\"Hasil: **{bundle['label'][0]}**\")\n",
        "    st.metric(\"Probabilitas penyakit jantung\", f\"{proba:.1%}\")\n",
        "    st.progress(float(proba))\n",
        "    st.caption(\"Hasil ini hanya prediksi model untuk keperluan tugas/pembelajaran, bukan diagnosis medis.\")"
      ]
    },
