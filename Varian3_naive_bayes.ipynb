            "    accuracy                           0.90       184\n",
            "   macro avg       0.90      0.89      0.90       184\n",
            "weighted avg       0.90      0.90      0.90       184\n",
            "\n",
            "\n",
            "CLASSIFICATION REPORT S5 - Top 5 (MI)\n",
            "              precision    recall  f1-score   support\n",
            "\n",
            " Tidak Sakit       0.83      0.85      0.84        82\n",
            "       Sakit       0.88      0.86      0.87       102\n",
            "\n",
            "    accuracy                           0.86       184\n",
            "   macro avg       0.86      0.86      0.86       184\n",
            "weighted avg       0.86      0.86      0.86       184\n",
            "\n"
          ]
        }
      ],
      "source": [
        "hasil_evaluasi = []\n",
        "confusion_matrices = {}\n",
        "model_tersimpan = {}\n",
        "cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)\n",
        "\n",
        "for nama, fitur in skenario_fitur.items():\n",
        "    model = buat_model(fitur)\n",
        "    model.fit(X_train[fitur], y_train)\n",
        "    y_pred = model.predict(X_test[fitur])\n",
        "\n",
        "    cv_acc = cross_val_score(buat_model(fitur), X_train[fitur], y_train, cv=cv, scoring=\"accuracy\").mean()\n",
        "\n",
        "    hasil_evaluasi.append({\n",
        "        \"Skenario\": nama,\n",
        "        \"Jumlah Fitur\": len(fitur),\n",
        "        \"Accuracy\": accuracy_score(y_test, y_pred),\n",
        "        \"Precision\": precision_score(y_test, y_pred),\n",
        "        \"Recall\": recall_score(y_test, y_pred),\n",
        "        \"F1-Score\": f1_score(y_test, y_pred),\n",
        "        \"CV Accuracy (5-fold)\": cv_acc,\n",
        "    })\n",
        "\n",
        "    confusion_matrices[nama] = confusion_matrix(y_test, y_pred)\n",
        "    model_tersimpan[nama] = model\n",
        "\n",
        "    print(f\"\\nCLASSIFICATION REPORT {nama}\")\n",
        "    print(classification_report(y_test, y_pred, target_names=[\"Tidak Sakit\", \"Sakit\"], zero_division=0))"
      ]
    },
