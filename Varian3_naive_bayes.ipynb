        "sns.barplot(data=mi_df, x=\"Mutual Information\", y=\"Fitur\", palette=\"Blues_r\")\n",
        "plt.title(\"Ranking Kepentingan Fitur (Mutual Information)\")\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "urutan_fitur = mi_df[\"Fitur\"].tolist()"
